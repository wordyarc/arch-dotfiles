{
    "app_config": {
        "audio_config": {
            "audio": "pipewire"
        }
    },
    "archinstall_language": "English",
    "bootloader_config": {
        "bootloader": "Systemd-boot",
        "removable": false,
        "uki": true
    },
    "custom_commands": [
        "sed -i 's/^#\\(ru_RU.UTF-8\\)/\\1/' /etc/locale.gen && locale-gen",
        "printf '127.0.0.1 localhost\\n::1 localhost\\n127.0.1.1 archlinux.localdomain archlinux\\n' > /etc/hosts",
        "printf '[zram0]\\nzram-size = ram / 2\\ncompression-algorithm = zstd\\nswap-priority = 100\\n' > /etc/systemd/zram-generator.conf",
        "mkswap -U clear --size 32G --file /swapfile && echo '/swapfile none swap defaults 0 0' >> /etc/fstab",
        "sed -i '/^MODULES=/s/()/(nvidia nvidia_modeset nvidia_uvm nvidia_drm)/; /^HOOKS=/s/ kms//' /etc/mkinitcpio.conf && mkinitcpio -P",
        "bootctl set-timeout 3"
    ],
    "firmware_optdeps": [],
    "hostname": "archlinux",
    "kernels": [
        "linux",
        "linux-lts"
    ],
    "locale_config": {
        "console_font": "default8x16",
        "kb_layout": "us",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    },
    "mirror_config": {
        "custom_repositories": [],
        "custom_servers": [],
        "mirror_regions": {},
        "optional_repositories": []
    },
    "network_config": {
        "type": "nm"
    },
    "ntp": true,
    "packages": [
        "amd-ucode",
        "linux-headers",
        "linux-lts-headers",
        "nvidia-open-dkms",
        "nvidia-utils",
        "sudo",
        "git",
        "vim",
        "zsh",
        "man-db",
        "man-pages",
        "efibootmgr"
    ],
    "pacman_config": {
        "color": true,
        "parallel_downloads": 5
    },
    "profile_config": {
        "gfx_driver": null,
        "greeter": null,
        "profile": {
            "custom_settings": {},
            "details": [],
            "main": "Minimal"
        }
    },
    "script": null,
    "services": [
        "systemd-boot-update"
    ],
    "swap": {
        "algorithm": "zstd",
        "enabled": true
    },
    "timezone": "Asia/Vladivostok",
    "version": "4.5"
}
